# Authentication Configuration
# Use 'openssl rand -base64 32' to generate a secure random string for production
BETTER_AUTH_SECRET=your_secret

# Silence KafkaJS warnings
KAFKAJS_NO_PARTITIONER_WARNING=1

# PostgreSQL Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=mls-app

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# MinIO Configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=mls-app

# Kafka Configuration
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Kafka per-service client & group IDs
# Use service-specific client and group IDs so each service can set its own values
KAFKA_CLIENT_ID_REST=rest-client
KAFKA_GROUP_ID_REST=rest-group
KAFKA_CLIENT_ID_WEBSOCKET=websocket-client
KAFKA_GROUP_ID_WEBSOCKET=websocket-group
KAFKA_CLIENT_ID_WORKER=worker-client
KAFKA_GROUP_ID_WORKER=worker-group

# Application Ports
PORT_REST=3001
PORT_WEBSOCKET=3002
PORT_WEBSITE=3000
PORT_WORKER=3003

# Constructed URLs
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
KAFKA_BROKERS=${KAFKA_HOST}:${KAFKA_PORT}
NEXT_PUBLIC_API_URL=http://localhost:3001