{
  "name": "@repo/monorepo",
  "private": true,
  "description": "Example of Turborepo setup with Bun, Biome/OXC and commitizen stuff.",
  "packageManager": "bun@1.3.6",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "authorize-setup-dev-script": "chmod +x scripts/setup-dev.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "rm -rf node_modules .turbo bun.lockb && find . -name generated -type d -exec rm -rf {} + && find . -name dist -type d -exec rm -rf {} + && find . -name .next -type d -exec rm -rf {} +",
    "check": "bun format-and-lint && bun check:case && bun check:knip",
    "check:case": "bunx --bun case-police",
    "check:knip": "bunx --bun knip",
    "check:updates": "bunx npm-check-updates -ui -ws",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "typecheck": "bun run --filter '*' typecheck",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml build --parallel",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:prod:deploy": "docker compose -f docker-compose.prod.yml up -d --build"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "useEmoji": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.2",
    "@changesets/changelog-github": "0.5.0",
    "@types/bun": "1.1.10",
    "@types/node": "22.7.4",
    "concurrently": "9.0.1",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@t3-oss/env-core": "^0.13.10",
    "@t3-oss/env-nextjs": "^0.13.10",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.3",
    "turbo": "^2.7.6",
    "zod": "^4.3.6"
  }
}
